# ── Discord application (same app as the bot) ──
DISCORD_CLIENT_ID=your-application-id
DISCORD_CLIENT_SECRET=your-client-secret
# Bot token: used server-side only, to list the bot's servers and each server's channels/roles
DISCORD_BOT_TOKEN=your-bot-token

# Public URL of this dashboard (no trailing slash). Add  <PUBLIC_URL>/api/auth/callback
# as a Redirect in Discord Developer Portal → OAuth2.
PUBLIC_URL=https://your-dashboard.vercel.app

# Long random string (32+ chars) used to encrypt the login cookie
SESSION_SECRET=change-me-to-a-long-random-string

# Same database as the bot
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/helix

# The bot's stats API through your Cloudflare Tunnel (e.g. https://api.yourdomain.com)
BOT_API_URL=https://api.yourdomain.com
BOT_API_KEY=same-value-as-API_KEY-in-the-bot

# ── Branding (all optional) ──
NEXT_PUBLIC_BRAND_NAME=Helix Utilities
NEXT_PUBLIC_BRAND_TAGLINE=Security, moderation and fun — in one bot.
NEXT_PUBLIC_BRAND_COLOR=#7c5cff
NEXT_PUBLIC_BRAND_LOGO=
NEXT_PUBLIC_SUPPORT_URL=
