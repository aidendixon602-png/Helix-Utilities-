# ───────────── Discord ─────────────
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
# Optional: register slash commands instantly to one server while testing (leave blank for global)
DEV_GUILD_ID=
# Comma-separated user IDs that can use owner-only commands
OWNER_IDS=
BOT_NAME=Helix Utilities
EMBED_COLOR=#7c5cff
SUPPORT_URL=
DASHBOARD_URL=https://your-dashboard.vercel.app

# ───────────── Database ─────────────
# MongoDB Atlas works great (free tier). The dashboard uses the SAME database.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/helix

# ───────────── Stats API (exposed via Cloudflare Tunnel) ─────────────
API_PORT=3001
# Long random string, must match BOT_API_KEY in the dashboard
API_KEY=change-me-to-a-long-random-string

# ───────────── Misc ─────────────
# IANA timezone used for birthday announcements
BIRTHDAY_TIMEZONE=UTC
LOG_LEVEL=info

# ───────────── Cloudflare Tunnel (docker compose --profile tunnel) ─────────────
CLOUDFLARE_TUNNEL_TOKEN=
